[gd_resource type="Resource" script_class="DialogueDefinition" load_steps=35 format=3]
[ext_resource type="Script" path="res://data/dialogue/dialogue_definition.gd" id="1_def"]
[ext_resource type="Script" path="res://data/dialogue/dialogue_node.gd" id="2_node"]
[ext_resource type="Script" path="res://data/dialogue/dialogue_choice.gd" id="3_choice"]
[ext_resource type="Script" path="res://data/content/content_condition.gd" id="4_condition"]
[ext_resource type="Script" path="res://data/content/content_action.gd" id="5_action"]

[sub_resource type="Resource" id="SprigbitAssigned"]
script = ExtResource("4_condition")
kind = 1
key = &"vs_sprigbit_assigned"
expected_value = "true"

[sub_resource type="Resource" id="IruNotDone"]
script = ExtResource("4_condition")
kind = 1
key = &"vs_iru_intro_done"
expected_value = "false"

[sub_resource type="Resource" id="IruDone"]
script = ExtResource("4_condition")
kind = 1
key = &"vs_iru_intro_done"
expected_value = "true"

[sub_resource type="Resource" id="FinishIru"]
script = ExtResource("5_action")
kind = 1
key = &"vs_iru_intro_done"
value = "true"

[sub_resource type="Resource" id="ChoiceYes"]
script = ExtResource("3_choice")
text = "Yes."
next_node_id = &"three_versions"

[sub_resource type="Resource" id="ChoiceDepends"]
script = ExtResource("3_choice")
text = "Depends what this is about."
next_node_id = &"three_versions"

[sub_resource type="Resource" id="ChoiceReturn"]
script = ExtResource("3_choice")
text = "Can I return it?"
next_node_id = &"three_versions"

[sub_resource type="Resource" id="ChoiceNotReal"]
script = ExtResource("3_choice")
text = "That is not a real number."
next_node_id = &"real_number"

[sub_resource type="Resource" id="ChoiceWonFarm"]
script = ExtResource("3_choice")
text = "I won the farm."
next_node_id = &"real_number"

[sub_resource type="Resource" id="ChoiceTakeBack"]
script = ExtResource("3_choice")
text = "Take it back."
next_node_id = &"real_number"

[sub_resource type="Resource" id="ChoiceWithDeed"]
script = ExtResource("3_choice")
text = "It was with the deed."
next_node_id = &"black_ledger"

[sub_resource type="Resource" id="ChoiceValuable"]
script = ExtResource("3_choice")
text = "Is it valuable?"
next_node_id = &"black_ledger"

[sub_resource type="Resource" id="ChoiceConfiscate"]
script = ExtResource("3_choice")
text = "You look like you want to confiscate it."
next_node_id = &"black_ledger"

[sub_resource type="Resource" id="Start"]
script = ExtResource("2_node")
node_id = &"start"
text = "Are you the registered winner of Lucky Acre? Please say no. I have walked very far."
conditions = Array[ContentCondition]([SubResource("SprigbitAssigned"), SubResource("IruNotDone")])
choices = Array[DialogueChoice]([SubResource("ChoiceYes"), SubResource("ChoiceDepends"), SubResource("ChoiceReturn")])

[sub_resource type="Resource" id="ThreeVersions"]
script = ExtResource("2_node")
node_id = &"three_versions"
entry_point = false
text = "That is three versions of yes."
next_node_id = &"debt_reveal"

[sub_resource type="Resource" id="DebtReveal"]
script = ExtResource("2_node")
node_id = &"debt_reveal"
entry_point = false
text = "Lucky Acre carries an outstanding Accord valuation of 888,888 Marks."
choices = Array[DialogueChoice]([SubResource("ChoiceNotReal"), SubResource("ChoiceWonFarm"), SubResource("ChoiceTakeBack")])

[sub_resource type="Resource" id="RealNumber"]
script = ExtResource("2_node")
node_id = &"real_number"
entry_point = false
text = "It is unfortunately a very real number printed with excellent ink."
next_node_id = &"mei_free"

[sub_resource type="Resource" id="MeiFree"]
script = ExtResource("2_node")
node_id = &"mei_free"
entry_point = false
speaker_npc_id = &"npc.central_basin.mei"
text = "You said the raffle was free."
next_node_id = &"raffle_free"

[sub_resource type="Resource" id="RaffleFree"]
script = ExtResource("2_node")
node_id = &"raffle_free"
entry_point = false
text = "The raffle was free. Ownership has been much more ambitious."
next_node_id = &"payment_gate"

[sub_resource type="Resource" id="PaymentGate"]
script = ExtResource("2_node")
node_id = &"payment_gate"
entry_point = false
text = "There is a first payment gate of 5,000 Marks. Farming, contracts, sales—anything lawful counts."
next_node_id = &"where_ledger"

[sub_resource type="Resource" id="WhereLedger"]
script = ExtResource("2_node")
node_id = &"where_ledger"
entry_point = false
text = "…Where did you get that?"
choices = Array[DialogueChoice]([SubResource("ChoiceWithDeed"), SubResource("ChoiceValuable"), SubResource("ChoiceConfiscate")])

[sub_resource type="Resource" id="BlackLedger"]
script = ExtResource("2_node")
node_id = &"black_ledger"
entry_point = false
text = "That is a Black Ledger. Those are not supposed to exist outside archival custody."
next_node_id = &"knows_name"

[sub_resource type="Resource" id="KnowsName"]
script = ExtResource("2_node")
node_id = &"knows_name"
entry_point = false
text = "More specifically, that one is not supposed to know your name."
actions = Array[ContentAction]([SubResource("FinishIru")])

[sub_resource type="Resource" id="PostConversation"]
script = ExtResource("2_node")
node_id = &"post_conversation"
text = "I am going to report this accurately and with extremely selective adjectives."
conditions = Array[ContentCondition]([SubResource("IruDone")])

[resource]
script = ExtResource("1_def")
content_id = &"dialogue.central_basin.ledger_clerk_demo"
display_name = "Iru Vale — Debt & Black Ledger"
description = "Canonical September 2026 debt notice and Black Ledger reveal."
tags = Array[StringName]([&"dialogue", &"iru", &"mq00", &"black_ledger", &"vertical_slice", &"canonical"])
start_node_id = &"start"
nodes = Array[DialogueNode]([SubResource("Start"), SubResource("ThreeVersions"), SubResource("DebtReveal"), SubResource("RealNumber"), SubResource("MeiFree"), SubResource("RaffleFree"), SubResource("PaymentGate"), SubResource("WhereLedger"), SubResource("BlackLedger"), SubResource("KnowsName"), SubResource("PostConversation")])
