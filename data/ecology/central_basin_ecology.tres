[gd_resource type="Resource" script_class="EcologyProfileDefinition" load_steps=2 format=3]
[ext_resource type="Script" path="res://data/ecology/ecology_profile_definition.gd" id="1"]
[resource]
script = ExtResource("1")
content_id = &"ecology.central_basin"
display_name = "Central Basin Ecology"
description = "Foundation ecology profile for the Central Basin habitats and resource systems."
tags = Array[StringName]([&"ecology", &"central_basin"])
