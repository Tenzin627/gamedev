[gd_resource type="Resource" script_class="CropDefinition" load_steps=2 format=3]
[ext_resource path="res://data/farming/crop_definition.gd" type="Script" id="1"]
[resource]
script = ExtResource("1")
content_id = &"crop.moonroot"
display_name = "Moonroot"
description = "A dependable basin crop that grows through watered days on the home farm."
