[resource]
script = ExtResource("1_habitat")
content_id = &"habitat.central_basin.riverbank"
display_name = "Central Basin Riverbank"
description = "Reed-lined river edge habitat used by small aquatic and bank-dwelling creatures."
tags = Array[StringName]([&"habitat", &"central_basin", &"riverbank"])
habitat_tags = Array[StringName]([&"river", &"riverbank"])
required_region_tags = Array[StringName]([&"river"])
spawn_entries = Array[ResourceDropEntry]([SubResource("SpawnEntry_rillfin"), SubResource("SpawnEntry_brambleback"), SubResource("SpawnEntry_mossback")])
max_creatures_alive = 5
initial_creatures = 3
respawn_delay_seconds = 12.0
minimum_player_distance = 120.0
creature_spacing = 38.0
