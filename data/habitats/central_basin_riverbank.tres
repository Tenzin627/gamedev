[gd_resource type="Resource" script_class="HabitatDefinition" load_steps=6 format=3]

[ext_resource type="Script" path="res://data/habitats/habitat_definition.gd" id="1_habitat"]
[ext_resource type="Script" path="res://data/habitats/habitat_spawn_entry.gd" id="2_entry"]

[sub_resource type="Resource" id="SpawnEntry_rillfin"]
script = ExtResource("2_entry")
species_id = &"creature.rillfin.baby"
spawn_weight = 3.0
min_group_size = 1
max_group_size = 2
active_time_tags = Array[StringName]([&"dawn", &"day", &"dusk"])
minimum_ecology_health = 0.25

[sub_resource type="Resource" id="SpawnEntry_mossback"]
script = ExtResource("2_entry")
species_id = &"creature.mossback.baby"
spawn_weight = 1.0
min_group_size = 1
max_group_size = 1
active_time_tags = Array[StringName]([&"day", &"dusk", &"night"])
