[gd_resource type="Resource" script_class="ZoneDefinition" load_steps=2 format=3]

[ext_resource type="Script" path="res://data/regions/zone_definition.gd" id="1_zone"]

[resource]
script = ExtResource("1_zone")
content_id = &"zone.central_basin.demo_wilds"
display_name = "Basin Wilds"
description = "A dense wilderness pocket for the 15-minute demo: resources, a creature habitat, the quest clearing, and one optional discovery."
tags = Array[StringName]([&"zone", &"central_basin", &"demo", &"wilds"])
region_id = &"region.central_basin"
scene_path = "res://world/central_basin/zones/demo_wilds.tscn"
default_spawn_id = &"default"
neighbor_zone_ids = Array[StringName]([&"zone.central_basin.demo_village"])
zone_tags = Array[StringName]([&"wilds", &"riverbank", &"encounter", &"gathering"])
weather_profile_id = &"weather_profile.central_basin"
