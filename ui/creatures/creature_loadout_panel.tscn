[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://ui/creatures/creature_loadout_panel.gd" id="1"]

[node name="CreatureLoadoutPanel" type="PanelContainer"]
offset_right = 720.0
offset_bottom = 600.0
script = ExtResource("1")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 18
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 18
theme_override_constants/margin_bottom = 16

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="Margin/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 22
text = "Creature Loadout"

[node name="Summary" type="Label" parent="Margin/VBox"]
layout_mode = 2
autowrap_mode = 2
text = "Creature summary"

[node name="Hint" type="Label" parent="Margin/VBox"]
layout_mode = 2
autowrap_mode = 2
text = "Choose exactly one active trait from this creature's two candidates. Equip and order up to four learned moves. Battle reads this loadout but does not own it."

[node name="Scroll" type="ScrollContainer" parent="Margin/VBox"]
layout_mode = 2
size_flags_vertical = 3

[node name="Content" type="VBoxContainer" parent="Margin/VBox/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 14

[node name="TraitSection" type="VBoxContainer" parent="Margin/VBox/Scroll/Content"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Heading" type="Label" parent="Margin/VBox/Scroll/Content/TraitSection"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "Trait Selection"

[node name="TraitList" type="VBoxContainer" parent="Margin/VBox/Scroll/Content/TraitSection"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="MoveSection" type="VBoxContainer" parent="Margin/VBox/Scroll/Content"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="EquippedHeading" type="Label" parent="Margin/VBox/Scroll/Content/MoveSection"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "Equipped Moves — maximum 4"

[node name="EquippedList" type="VBoxContainer" parent="Margin/VBox/Scroll/Content/MoveSection"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="LearnedHeading" type="Label" parent="Margin/VBox/Scroll/Content/MoveSection"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "Learned Moves"

[node name="LearnedList" type="VBoxContainer" parent="Margin/VBox/Scroll/Content/MoveSection"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Buttons" type="HBoxContainer" parent="Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="BackButton" type="Button" parent="Margin/VBox/Buttons"]
layout_mode = 2
text = "Back to Roster"

[node name="CloseButton" type="Button" parent="Margin/VBox/Buttons"]
layout_mode = 2
text = "Close"
